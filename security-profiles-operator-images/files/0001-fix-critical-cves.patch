From 20ea5490b105d8b72d763e203b89fee56ad12e62 Mon Sep 17 00:00:00 2001
From: Md Irshad Sheikh <mdirshad.sheikh@windriver.com>
Date: Tue, 12 Aug 2025 06:35:00 -0400
Subject: [PATCH] fix critical cves
CVE-2024-24790
CVE-2024-45337
---
 Makefile               |  4 ++++
 go.mod                 |  6 +++---
 nix/derivation-bpf.nix |  2 +-
 nix/derivation.nix     |  2 +-
 nix/nixpkgs.json       | 10 +++++-----
 nix/overlay.nix        |  1 +
 6 files changed, 15 insertions(+), 10 deletions(-)

diff --git a/Makefile b/Makefile
index eedcce8..2170a14 100644
--- a/Makefile
+++ b/Makefile
@@ -152,9 +152,13 @@ define go-build-spo
 endef
 
 $(BUILD_DIR)/$(PROJECT): $(BUILD_DIR) $(BUILD_FILES)
+	GOPROXY=https://proxy.golang.org,direct go mod tidy
+	GOPROXY=https://proxy.golang.org,direct go mod vendor
 	$(call go-build-spo,$(PROJECT))
 
 $(BUILD_DIR)/$(CLI_BINARY): $(BUILD_DIR) $(BUILD_FILES)
+	GOPROXY=https://proxy.golang.org,direct go mod tidy
+	GOPROXY=https://proxy.golang.org,direct go mod vendor
 	$(call go-build-spo,$(CLI_BINARY))
 
 .PHONY: clean
diff --git a/go.mod b/go.mod
index fff97b1..b1665ae 100644
--- a/go.mod
+++ b/go.mod
@@ -1,6 +1,6 @@
 module sigs.k8s.io/security-profiles-operator
 
-go 1.21
+go 1.23
 
 require (
 	github.com/acobaugh/osrelease v0.1.0
@@ -149,7 +149,7 @@ require (
 	github.com/gobwas/glob v0.2.3 // indirect
 	github.com/godbus/dbus/v5 v5.1.0 // indirect
 	github.com/gogo/protobuf v1.3.2 // indirect
-	github.com/golang-jwt/jwt/v4 v4.5.0 // indirect
+	github.com/golang-jwt/jwt/v4 v4.5.2 // indirect
 	github.com/golang/groupcache v0.0.0-20210331224755-41bb18bfe9da // indirect
 	github.com/golang/protobuf v1.5.4 // indirect
 	github.com/golang/snappy v0.0.4 // indirect
@@ -250,7 +250,7 @@ require (
 	go.step.sm/crypto v0.42.1 // indirect
 	go.uber.org/multierr v1.11.0 // indirect
 	go.uber.org/zap v1.26.0 // indirect
-	golang.org/x/crypto v0.22.0 // indirect
+	golang.org/x/crypto v0.35.0 // indirect
 	golang.org/x/exp v0.0.0-20240222234643-814bf88cf225 // indirect
 	golang.org/x/oauth2 v0.17.0 // indirect
 	golang.org/x/sys v0.19.0 // indirect
diff --git a/nix/derivation-bpf.nix b/nix/derivation-bpf.nix
index 96fc0b1..1b6485f 100644
--- a/nix/derivation-bpf.nix
+++ b/nix/derivation-bpf.nix
@@ -1,5 +1,5 @@
 { pkgs, buildGoModule, arch ? "x86" }:
-with pkgs; buildGo122Module rec {
+with pkgs; buildGo123Module rec {
   name = "security-profiles-operator";
   src = ./..;
   vendorHash = null;
