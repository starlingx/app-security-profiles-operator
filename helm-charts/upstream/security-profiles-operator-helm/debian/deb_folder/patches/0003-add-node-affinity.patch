From 326945c31427d2df3dfacf36262f43fbb4230335 Mon Sep 17 00:00:00 2001
From: Sabyasachi Nayak <sabyasachi.nayak@windriver.com>
Date: Thu, 30 May 2024 11:56:57 -0400
Subject: [PATCH] add node affinity terms for SPO

Signed-off-by: Sabyasachi Nayak <sabyasachi.nayak@windriver.com>
---
 templates/deployment.yaml | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/templates/deployment.yaml b/templates/deployment.yaml
index 26ee0ad..8959a76 100644
--- a/templates/deployment.yaml
+++ b/templates/deployment.yaml
@@ -55,10 +55,13 @@ spec:
       nodeSelector:
         {{- toYaml . | nindent 8 }}
       {{- end }}
-      {{- with .Values.affinity }}
       affinity:
-        {{- toYaml . | nindent 8 }}
-      {{- end }}
+        nodeAffinity:
+          requiredDuringSchedulingIgnoredDuringExecution:
+            nodeSelectorTerms:
+            - matchExpressions:
+              - key: node-role.kubernetes.io/control-plane
+                operator: Exists
       tolerations:
       - effect: NoSchedule
         key: node-role.kubernetes.io/master
--
2.25.1