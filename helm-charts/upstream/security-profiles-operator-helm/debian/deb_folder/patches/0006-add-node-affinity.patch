From 2e0d4bf57ee889f9bb7db729c0d8bc56a84b1747 Mon Sep 17 00:00:00 2001
From: hsonde <harshad.sonde@windriver.com>
Date: Tue, 3 Jan 2023 06:05:32 -0500
Subject: [PATCH 1/1] add node affinity terms for SPO

Signed-off-by: hsonde <harshad.sonde@windriver.com>
---
 templates/deployment.yaml | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/templates/deployment.yaml b/templates/deployment.yaml
index 2a9b7fb3..9f804d80 100644
--- a/templates/deployment.yaml
+++ b/templates/deployment.yaml
@@ -46,10 +46,13 @@ spec:
       nodeSelector:
         {{- toYaml . | nindent 8 }}
       {{- end }}
-      {{- with .Values.affinity }}
       affinity:
-        {{- toYaml . | nindent 8 }}
-      {{- end }}
+        nodeAffinity:
+          requiredDuringSchedulingIgnoredDuringExecution:
+            nodeSelectorTerms:
+            - matchExpressions:
+              - key: node-role.kubernetes.io/control-plane
+                operator: Exists
       serviceAccountName: security-profiles-operator
       tolerations:
       - effect: NoSchedule
--
2.25.1

