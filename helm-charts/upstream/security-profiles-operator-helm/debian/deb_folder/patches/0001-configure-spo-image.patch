From e16e1230cacfdeec2fe7edd627460887c957662d Mon Sep 17 00:00:00 2001
From: Sabyasachi Nayak <sabyasachi.nayak@windriver.com>
Date: Fri, 31 May 2024 05:37:52 -0400
Subject: [PATCH] Configure SPO image

Signed-off-by: Sabyasachi Nayak <sabyasachi.nayak@windriver.com>
---
 templates/deployment.yaml | 4 +++-
 values.yaml               | 5 ++---
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/templates/deployment.yaml b/templates/deployment.yaml
index b03cc9d..cdd380b 100644
--- a/templates/deployment.yaml
+++ b/templates/deployment.yaml
@@ -20,6 +20,8 @@ spec:
       labels:
         {{- include "security-profiles-operator.selectorLabels" . | nindent 8 }}
     spec:
+      imagePullSecrets:
+      - name: default-registry-key
       containers:
       - args:
         - manager
@@ -36,7 +38,7 @@ spec:
           valueFrom:
             fieldRef:
               fieldPath: metadata.namespace
-        image: {{ .Values.spoImage.registry }}/{{ .Values.spoImage.repository }}:{{ .Values.spoImage.tag }}
+        image: {{ .Values.spoImage.repository }}:{{ .Values.spoImage.tag }}
         imagePullPolicy: Always
         name: {{ .Chart.Name }}
         resources:
diff --git a/values.yaml b/values.yaml
index 1167291..3225d30 100644
--- a/values.yaml
+++ b/values.yaml
@@ -2,9 +2,8 @@
 replicaCount: 3

 spoImage:
-  registry: gcr.io
-  repository: k8s-staging-sp-operator/security-profiles-operator
-  tag: latest
+  repository: registry.local:9001/docker.io/starlingx/security-profiles-operator
+  tag: stx.11.0-v0.8.3-1

 enableSelinux: false
 enableLogEnricher: false
--
2.25.1

