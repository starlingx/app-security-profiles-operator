From 82974bc3b3e2a7030adf1f7375e85c49a8ce6d6a Mon Sep 17 00:00:00 2001
From: Test User <test@example.com>
Date: Tue, 23 Jun 2026 17:19:32 -0400
Subject: [PATCH] Configure SPO for StarlingX with image format

Signed-off-by: Test User <test@example.com>
---
 deploy/helm/templates/_helpers.tpl    |  2 --
 deploy/helm/templates/deployment.yaml | 66 +++++++++++++++++----------------------
 deploy/helm/values.yaml               | 14 ++++++---
 3 files changed, 37 insertions(+), 45 deletions(-)

diff --git a/deploy/helm/templates/_helpers.tpl b/deploy/helm/templates/_helpers.tpl
index ee6dbdc..7bf3a99 100644
--- a/deploy/helm/templates/_helpers.tpl
+++ b/deploy/helm/templates/_helpers.tpl
@@ -55,8 +55,6 @@ Selector labels
 {{- define "security-profiles-operator.selectorLabels" -}}
 app: security-profiles-operator
 name: security-profiles-operator
-app.kubernetes.io/name: {{ include "security-profiles-operator.name" . }}
-app.kubernetes.io/instance: {{ include "security-profiles-operator.name" . }}
 {{- end }}
 
 {{/*
diff --git a/deploy/helm/templates/deployment.yaml b/deploy/helm/templates/deployment.yaml
index bc234e9..adbea68 100644
--- a/deploy/helm/templates/deployment.yaml
+++ b/deploy/helm/templates/deployment.yaml
@@ -1,62 +1,53 @@
 apiVersion: apps/v1
 kind: Deployment
 metadata:
-  labels:
-    {{- include "security-profiles-operator.labels" . | nindent 4 }}
+  labels:{{include "security-profiles-operator.labels" . | nindent 4}}
   name: security-profiles-operator
-  namespace: {{ .Release.Namespace }}
-spec:
-  {{- if not .Values.autoscaling.enabled }}
-  replicas: {{ .Values.replicaCount }}
-  {{- end }}
+  namespace: {{.Release.Namespace}}
+spec:{{if not .Values.autoscaling.enabled}}
+  replicas: {{.Values.replicaCount}}{{end}}
   selector:
-    matchLabels:
-      {{- include "security-profiles-operator.selectorLabels" . | nindent 6 }}
+    matchLabels:{{include "security-profiles-operator.selectorLabels" . | nindent 6}}
   template:
     metadata:
       annotations:
-        seccomp.security.alpha.kubernetes.io/pod: runtime/default
-        {{- include "security-profiles-operator.annotations" . | nindent 8 }}
-      labels:
-        {{- include "security-profiles-operator.selectorLabels" . | nindent 8 }}
+        seccomp.security.alpha.kubernetes.io/pod: runtime/default{{include "security-profiles-operator.annotations" . | nindent 8}}
+      labels:{{include "security-profiles-operator.selectorLabels" . | nindent 8}}
     spec:
       containers:
       - args:
         - manager
         env:
         - name: RELATED_IMAGE_SELINUXD
-          value: {{ .Values.selinuxdImage.default.registry }}/{{ .Values.selinuxdImage.default.repository }}:{{ .Values.selinuxdImage.default.tag }}
+          value: {{.Values.selinuxdImage.default.registry}}/{{.Values.selinuxdImage.default.repository}}:{{.Values.selinuxdImage.default.tag}}
         - name: RELATED_IMAGE_SELINUXD_EL8
-          value: {{ .Values.selinuxdImage.el8.registry }}/{{ .Values.selinuxdImage.el8.repository }}:{{ .Values.selinuxdImage.el8.tag }}
+          value: {{.Values.selinuxdImage.el8.registry}}/{{.Values.selinuxdImage.el8.repository}}:{{.Values.selinuxdImage.el8.tag}}
         - name: RELATED_IMAGE_SELINUXD_EL9
-          value: {{ .Values.selinuxdImage.el9.registry }}/{{ .Values.selinuxdImage.el9.repository }}:{{ .Values.selinuxdImage.el9.tag }}
+          value: {{.Values.selinuxdImage.el9.registry}}/{{.Values.selinuxdImage.el9.repository}}:{{.Values.selinuxdImage.el9.tag}}
         - name: RELATED_IMAGE_SELINUXD_FEDORA
-          value: {{ .Values.selinuxdImage.fedora.registry }}/{{ .Values.selinuxdImage.fedora.repository }}:{{ .Values.selinuxdImage.fedora.tag }}
+          value: {{.Values.selinuxdImage.fedora.registry}}/{{.Values.selinuxdImage.fedora.repository}}:{{.Values.selinuxdImage.fedora.tag}}
         - name: OPERATOR_NAMESPACE
           valueFrom:
             fieldRef:
               fieldPath: metadata.namespace
-        image: {{ .Values.spoImage.registry }}/{{ .Values.spoImage.repository }}:{{ .Values.spoImage.tag }}
+        image: {{.Values.spo.image.repository}}:{{.Values.spo.image.tag}}
         imagePullPolicy: Always
-        name: {{ .Chart.Name }}
-        resources:
-          {{- toYaml .Values.resources | nindent 10 }}
+        name: {{.Chart.Name}}
+        resources:{{toYaml .Values.resources | nindent 10}}
         securityContext:
           allowPrivilegeEscalation: false
-          readOnlyRootFilesystem: true
-      {{- with .Values.podSecurityContext }}
-      securityContext:
-      {{- toYaml . | nindent 8 }}
-      {{- end }}
-      serviceAccountName: security-profiles-operator
-      {{- with .Values.nodeSelector }}
-      nodeSelector:
-        {{- toYaml . | nindent 8 }}
-      {{- end }}
-      {{- with .Values.affinity }}
+          readOnlyRootFilesystem: true{{with .Values.podSecurityContext}}
+      securityContext:{{toYaml . | nindent 8}}{{end}}
+      serviceAccountName: security-profiles-operator{{with .Values.nodeSelector}}
+      nodeSelector:{{toYaml . | nindent 8}}{{end}}
       affinity:
-        {{- toYaml . | nindent 8 }}
-      {{- end }}
+        nodeAffinity:
+          requiredDuringSchedulingIgnoredDuringExecution:
+            nodeSelectorTerms:
+            - matchExpressions:
+              - key: node-role.kubernetes.io/control-plane
+                operator: Exists
+
       tolerations:
       - effect: NoSchedule
         key: node-role.kubernetes.io/master
@@ -66,7 +57,6 @@ spec:
         operator: Exists
       - effect: NoExecute
         key: node.kubernetes.io/not-ready
-        operator: Exists
-      {{- with .Values.tolerations }}
-        {{- toYaml . | nindent 6 }}
-      {{- end }}
+        operator: Exists{{with .Values.tolerations}}{{toYaml . | nindent 6}}{{end}}
+      imagePullSecrets:
+      - name: default-registry-key
diff --git a/deploy/helm/values.yaml b/deploy/helm/values.yaml
index 6833e49..e9bbae7 100644
--- a/deploy/helm/values.yaml
+++ b/deploy/helm/values.yaml
@@ -1,10 +1,14 @@
 # Default values for security-profiles-operator.
 replicaCount: 3
 
-spoImage:
-  registry: gcr.io
-  repository: k8s-staging-sp-operator/security-profiles-operator
-  tag: latest
+spo:
+  image:
+    repository: docker.io/starlingx/security-profiles-operator
+    tag: stx.13.0-v1.0.0-1-@OS_CODENAME@
+krp:
+  image:
+    repository: quay.io/brancz/kube-rbac-proxy
+    tag: v0.22.0
 
 selinuxdImage:
   default:
@@ -27,7 +31,7 @@ selinuxdImage:
 enableSelinux: false
 enableLogEnricher: false
 enableJsonEnricher: false
-enableAppArmor: false
+enableAppArmor: true
 enableBpfRecorder: false
 enableProfiling: false
 verbosity: 0
-- 
2.54.0
